# Copy to .env for local runs (.env is git-ignored). On Render, set these in the
# dashboard instead.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional web-search fallback (https://tavily.com). Leave empty to disable.
TAVILY_API_KEY=

# true = no Gemini calls at all; answers are the matching passages verbatim.
OFFLINE_MODE=false

# false = skip the second "self-critique" Gemini call per question.
ENABLE_SELF_CRITIQUE=true

# Tunables (defaults shown)
# TOP_K=4
# RETRIEVAL_MIN_SCORE=0.35
# RATE_LIMIT_PER_MINUTE=20
# MAX_MESSAGE_CHARS=1000

# Optional Langfuse tracing (also needs: pip install "langfuse>=3,<4")
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
